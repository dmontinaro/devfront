{
  "name": "devfront",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write . && eslint --fix .",
    "check": "pnpm generate-routes && pnpm typecheck && pnpm test && pnpm lint && prettier --check ."
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.31",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.48",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.167.32",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.8.1",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
